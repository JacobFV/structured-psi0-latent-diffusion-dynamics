{
  "name": "rrp-viz-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "snapshot": "cd ../.. && PYTHONPATH=src nice -n 10 .venv/bin/python -m rrp.viz.export --out viz/data"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
