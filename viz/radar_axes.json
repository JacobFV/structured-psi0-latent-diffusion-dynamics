{
 "schema": "rrp-viz/radar-axes/v1",
 "purpose": "Declared, evidence-backed multi-axis comparison of the routes (after IBM-2's configs/workbench/radar_axes.json). Values are read at export from the exporter's own normalized documents (results, edits, robustness); nothing is typed in here except floors and declared reference constants.",
 "normalization": {
  "kind": "floor_to_reference",
  "clamp": [
   0,
   1.5
  ],
  "rule": "r = (x - floor) / (reference - floor) for higher-is-better and (floor - x) / (floor - reference) for lower-is-better; reference = the declared reference series' value on that axis, or a declared constant; r = 0 at the floor, 1 at the reference; clamped to [0, 1.5] for drawing (unclamped r kept). Missing inputs stay missing (gaps)."
 },
 "series": [
  {
   "id": "teacher",
   "label": "scripted teacher (privileged)"
  },
  {
   "id": "bc",
   "label": "BC (direct action)"
  },
  {
   "id": "semfix",
   "label": "latent · semantic (semfix)"
  },
  {
   "id": "nosem",
   "label": "latent · no semantics (nosem)"
  },
  {
   "id": "frozen_sem",
   "label": "latent · frozen sem"
  }
 ],
 "selector_help": "doc: results|edits|robustness; list: rows (default)|reports|levels; where: field -> regex (seed '^$' = pooled row); key_path: list of regexes matched element-wise; agg: sum_kn (Σk/Σn; group = key_path index for the spread) | effect (row effect with its ci; negate flips sign) | path (value/ci/k/n paths into the row).",
 "axes": [
  {
   "id": "arm_gv2_panda_pg2",
   "label": "arm gv2 panda",
   "metric": "deployable success rate",
   "direction": "max",
   "protocol": "pick_place on panda_pg2, grasp_v2 physics, 90 episodes per lineage seed (armexpert_gc2eval/compare_gc2_final.json)",
   "decision": "D-127",
   "floor": {
    "value": 0.0,
    "meaning": "no success"
   },
   "reference": {
    "series": "bc"
   },
   "series": {
    "semfix": {
     "doc": "results",
     "where": {
      "source_file": "compare_gc2_final.json$",
      "metric": "^grasp_v2$"
     },
     "key_path": [
      "^semfix, seed",
      "^panda_pg2$",
      "^grasp_v2$"
     ],
     "agg": "sum_kn",
     "group": 0
    },
    "nosem": {
     "doc": "results",
     "where": {
      "source_file": "compare_gc2_final.json$",
      "metric": "^grasp_v2$"
     },
     "key_path": [
      "^nosem, seed",
      "^panda_pg2$",
      "^grasp_v2$"
     ],
     "agg": "sum_kn",
     "group": 0
    },
    "frozen_sem": {
     "doc": "results",
     "where": {
      "source_file": "compare_gc2_final.json$",
      "metric": "^grasp_v2$"
     },
     "key_path": [
      "^frozen sem, seed",
      "^panda_pg2$",
      "^grasp_v2$"
     ],
     "agg": "sum_kn",
     "group": 0
    },
    "bc": {
     "doc": "results",
     "where": {
      "source_file": "compare_gc2_final.json$",
      "metric": "^grasp_v2$"
     },
     "key_path": [
      "^BC direct1701",
      "^panda_pg2$",
      "^grasp_v2$"
