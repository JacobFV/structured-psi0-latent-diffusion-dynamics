{
 "schema": "rrp-viz/radar-axes/v1",
 "purpose": "Declared, evidence-backed multi-axis comparison of the routes (after IBM-2's configs/workbench/radar_axes.json). Values are read at export from the exporter's own normalized documents (results, edits, robustness); nothing is typed in here except floors and declared reference constants.",
 "normalization": {
  "kind": "floor_to_reference",
  "clamp": [
   0,
   1.5
  ],
  "rule": "r = (x - floor) / (reference - floor) for higher-is-better and (floor - x) / (floor - reference) for lower-is-better; reference = the declared reference series' value on that axis, or a declared constant; r = 0 at the floor, 1 at the reference; clamped to [0, 1.5] for drawing (unclamped r kept). Missing inputs stay missing (gaps)."
 },
 "series": [
  {
   "id": "teacher",
   "label": "scripted teacher (privileged)"
  },
  {
   "id": "bc",
   "label": "BC (direct action)"
  },
  {
   "id": "semfix_v6",
   "label": "latent semfix v6 (arm, grasp_v2.1 · D-134)"
  },
  {
   "id": "nosem_v6",
   "label": "latent nosem v6 (arm, grasp_v2.1 · D-134)"
  },
  {
   "id": "semfix",
   "label": "latent semfix (legged8)"
  },
  {
   "id": "nosem",
   "label": "latent nosem (legged8)"
  },
  {
   "id": "latent_jointfix",
   "label": "latent · ladder_flow_jointfix (the lineage D-058 timed)"
  }
 ],
 "selector_help": "doc: results|edits|robustness; list: rows (default)|reports|levels; where: field -> regex (seed '^$' = pooled row); key_path: list of regexes matched element-wise; agg: sum_kn (Σk/Σn; group = key_path index for the spread) | effect (row effect with its ci; negate flips sign) | path (value/ci/k/n paths into the row). file: a committed JSON file read directly (value/n paths). floor.reference_multiple: floor = that multiple of the resolved reference.",
