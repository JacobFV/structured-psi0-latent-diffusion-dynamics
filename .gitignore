# environments and caches (no trailing slash: these are symlinks in some checkouts/worktrees)
.venv
.cache
__pycache__/
*.pyc
node_modules/
*.tmp
MUJOCO_LOG.TXT

# ops runtime state (broker, logs, watchdog, token)
ops/broker/
ops/logs/
ops/watchdog/
ops/**/*.log

# data and weights never go in git (public repo): they live in the peer store / ~/work/rrp-data
artifacts/datasets
artifacts/packed
artifacts/checkpoints/
artifacts/episodes/
artifacts/video/raw/
*.pt
*.pth
*.ckpt
*.safetensors
*.npz
*.pkl
/.rrp_revision
viz/data/
viz/room/node_modules/
viz/room/dist/
# run data never enters git (public repo; D-147 2026-10-04): per-episode rollouts, arrays, videos, checkpoints under run dirs.
# Summaries and manifests (results.jsonl, tables.*, pipeline_manifest.json, run_context.json, *_config.json) stay trackable.
artifacts/runs/**/episodes/
artifacts/runs/**/*.npz
artifacts/runs/**/*.mp4
artifacts/runs/**/*.pt
